:root {
  color-scheme: light;
  font-family: "SF Pro Display", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  --bg: #f4f1eb;
  --paper: rgba(255, 255, 255, 0.86);
  --paper-strong: #ffffff;
  --line: rgba(40, 44, 52, 0.12);
  --text: #1c1c1c;
  --muted: #5e6470;
  --accent: #0f766e;
  --accent-soft: rgba(15, 118, 110, 0.14);
  --shadow: 0 18px 40px rgba(33, 35, 38, 0.08);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(15, 118, 110, 0.14), transparent 28%),
    radial-gradient(circle at top right, rgba(217, 119, 6, 0.12), transparent 24%),
    linear-gradient(180deg, #f9f7f2 0%, var(--bg) 100%);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  width: min(1280px, calc(100% - 32px));
  margin: 0 auto;
  padding: 28px 0 40px;
}

.app-shell.space-view {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.app-shell.space-view .layout {
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

.app-shell.space-view .workspace {
  overflow-y: auto;
  min-height: 0;
}

.app-shell.space-view .sidebar {
  overflow-y: auto;
  min-height: 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 24px;
}

.topbar h1,
.winner-band h2,
.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3.2rem);
  line-height: 1;
}

.subtitle,
.section-heading p,
.rating-row p,
.sidebar-panel p {
  margin: 0;
  color: var(--muted);
}

.eyebrow {
  margin: 0 0 8px;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
}

.topbar-actions,
.stepper,
.tab-row,
.inline-form,
.score-picker,
.progress-head {
  display: flex;
  gap: 12px;
  align-items: center;
}

.primary-button,
.secondary-button,
.step-chip,
.tab-chip,
.score-button,
.editable-chip button {
  border: 0;
  border-radius: 999px;
  transition: transform 120ms ease, background-color 120ms ease, color 120ms ease;
}

.primary-button,
.secondary-button {
  padding: 12px 18px;
  box-shadow: var(--shadow);
}

.primary-button {
  background: var(--text);
  color: white;
}

.secondary-button {
  background: var(--paper);
  color: var(--text);
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.9fr);
  gap: 20px;
}

.workspace,
.sidebar {
  display: grid;
  gap: 20px;
}

.panel,
.sidebar-panel,
.mini-panel {
  background: var(--paper);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.panel {
  padding: 24px;
  display: grid;
  gap: 22px;
}

.sidebar-panel,
.mini-panel {
  padding: 18px;
}

.section-heading,
.mini-panel-header {
  display: grid;
  gap: 8px;
}

.step-chip,
.tab-chip {
  background: rgba(255, 255, 255, 0.75);
  color: var(--muted);
  padding: 10px 16px;
}

.step-chip span {
  display: inline-grid;
  place-items: center;
  width: 24px;
  height: 24px;
  margin-right: 10px;
  border-radius: 50%;
  background: rgba(28, 28, 28, 0.08);
}

.step-chip.is-active,
.tab-chip.is-active,
.score-button.is-selected {
  background: var(--text);
  color: white;
}

.field {
  display: grid;
  gap: 8px;
}

.field input,
.criterion-name,
.inline-form input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--paper-strong);
}

.three-columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  min-height: 44px;
}

.editable-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--paper-strong);
  border: 1px solid var(--line);
}

.editable-chip button {
  width: 24px;
  height: 24px;
  background: rgba(28, 28, 28, 0.08);
}

.criteria-editor,
.rating-stack,
.ranking-list,
.stats-list {
  display: grid;
  gap: 14px;
}

.criterion-row,
.rating-row,
.ranking-row,
.progress-head,
.winner-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.criterion-name {
  max-width: 260px;
}

.criterion-slider {
  flex: 1;
}

.weight-badge {
  min-width: 68px;
  text-align: right;
  color: var(--muted);
}

.inline-note {
  padding: 14px 16px;
  border-radius: 16px;
  background: var(--accent-soft);
}

.rating-block {
  padding: 18px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
}

.rating-block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.rating-block-header h3,
.result-column h3,
.sidebar-panel h3 {
  margin: 0;
  font-size: 1.05rem;
}

.rating-grid,
.result-column,
.stats-list {
  display: grid;
  gap: 12px;
}

.score-picker {
  min-width: 280px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.score-button {
  width: 36px;
  height: 36px;
  background: rgba(28, 28, 28, 0.08);
  color: var(--text);
  font-size: 0.85rem;
}

.winner-band {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 22px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.12), rgba(255, 255, 255, 0.75));
}

.winner-stats {
  flex-wrap: wrap;
}

.winner-stats div {
  min-width: 120px;
  display: grid;
  gap: 4px;
}

.winner-stats span,
.stats-list dt {
  color: var(--muted);
}

.winner-stats strong,
.stats-list dd {
  margin: 0;
  font-size: 1.2rem;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.clean-list {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 10px;
}

.ranking-row {
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr) 70px;
}

.ranking-meta {
  display: flex;
  gap: 10px;
  align-items: center;
}

.ranking-bar,
.progress-bar {
  height: 12px;
  border-radius: 999px;
  background: rgba(28, 28, 28, 0.08);
  overflow: hidden;
}

.ranking-fill,
.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0f766e, #f59e0b);
}

.stats-list {
  margin: 0;
}

.stats-list div {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty-state {
  display: grid;
  gap: 14px;
  place-items: start;
}

/* Global margin fixes */
.app-shell > .panel {
  margin-bottom: 20px;
}

.app-shell > .panel:last-child {
  margin-bottom: 0;
}

/* Auth */
.auth-shell {
  display: grid;
  place-items: center;
  min-height: 80vh;
}

.auth-card {
  background: var(--paper);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 32px;
  width: min(420px, 100%);
  display: grid;
  gap: 18px;
}

.auth-card h1 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3.2rem);
  line-height: 1;
}

.auth-form {
  display: grid;
  gap: 14px;
}

.auth-toggle {
  display: flex;
  gap: 8px;
}

.auth-toggle button {
  flex: 1;
  padding: 10px;
  border: 0;
  border-radius: 999px;
  background: rgba(28, 28, 28, 0.06);
  color: var(--muted);
  cursor: pointer;
}

.auth-toggle button.is-active {
  background: var(--text);
  color: white;
}

.auth-error {
  color: #b91c1c;
  margin: 0;
}

/* Dashboard */
.space-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
}

.space-card {
  padding: 18px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
  cursor: pointer;
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.space-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}

.space-card h3 {
  margin: 0 0 6px;
  font-size: 1.1rem;
}

.space-card p {
  margin: 0 0 10px;
  color: var(--muted);
}

.space-code {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
}

.two-columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.form-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

/* Chat */
.chat-panel {
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 16px;
  min-height: 420px;
}

.chat-messages {
  display: grid;
  gap: 10px;
  align-content: flex-start;
  overflow-y: auto;
  max-height: 520px;
}

.chat-message {
  display: grid;
  gap: 4px;
  padding: 10px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--line);
  max-width: 80%;
}

.chat-message.is-me {
  background: var(--accent-soft);
  justify-self: flex-end;
}

.chat-author {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--accent);
}

.chat-content {
  font-size: 0.95rem;
}

.chat-time {
  font-size: 0.72rem;
  color: var(--muted);
}

.chat-form {
  margin-top: 4px;
}

/* Sidebar Chat */
.chat-sidebar-panel {
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 12px;
  min-height: 280px;
}

.sidebar-chat-messages {
  display: grid;
  gap: 8px;
  align-content: flex-start;
  overflow-y: auto;
  max-height: 320px;
}

.sidebar-chat-messages .chat-message {
  max-width: 95%;
}

/* Vote */
.vote-progress {
  padding: 12px 16px;
  border-radius: 16px;
  background: var(--accent-soft);
}

.vote-progress p {
  margin: 0;
}

.consensus-ok {
  background: rgba(34, 197, 94, 0.14);
  color: #15803d;
}

.consensus-bad {
  background: rgba(239, 68, 68, 0.14);
  color: #b91c1c;
}

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  z-index: 1000;
  padding: 20px;
}

.modal-card {
  background: var(--paper-strong);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 32px;
  width: min(560px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  display: grid;
  gap: 18px;
}

.modal-card h2 {
  margin: 0;
  font-size: clamp(1.6rem, 2.5vw, 2.4rem);
  line-height: 1;
}

.onboarding-steps {
  display: grid;
  gap: 14px;
}

.onboarding-step {
  padding: 14px 16px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
}

.onboarding-step strong {
  display: block;
  margin-bottom: 4px;
}

.onboarding-step p {
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
}

.modal-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.checkbox-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  color: var(--muted);
  font-size: 0.9rem;
  margin-right: auto;
}

.checkbox-label input[type="checkbox"] {
  width: 18px;
  height: 18px;
  accent-color: var(--accent);
}

/* Brief Description */
.description-textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--paper-strong);
  font: inherit;
  resize: vertical;
  min-height: 80px;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

.description-textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.brief-desc-modal {
  text-align: center;
  animation: briefDescSlideIn 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.brief-desc-icon {
  font-size: 2.8rem;
  margin-bottom: 4px;
  animation: briefDescBounce 600ms ease 200ms both;
}

.brief-desc-content {
  padding: 18px 22px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(217, 119, 6, 0.06));
  border: 1px solid var(--line);
  text-align: left;
}

.brief-desc-content p {
  margin: 0;
  color: var(--text);
  font-size: 1.02rem;
  line-height: 1.6;
}

.brief-desc-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 16px;
  border: 1px solid var(--accent);
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.1), rgba(15, 118, 110, 0.04));
  color: var(--accent);
  font-weight: 600;
  font-size: 0.88rem;
  cursor: pointer;
  transition: transform 120ms ease, background-color 200ms ease, box-shadow 200ms ease;
  backdrop-filter: blur(8px);
}

.brief-desc-button:hover {
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.18), rgba(15, 118, 110, 0.08));
  box-shadow: 0 4px 16px rgba(15, 118, 110, 0.18);
  transform: translateY(-1px);
}

.brief-desc-button:active {
  transform: translateY(0);
}

@keyframes briefDescSlideIn {
  0% {
    opacity: 0;
    transform: scale(0.85) translateY(30px);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes briefDescBounce {
  0% {
    opacity: 0;
    transform: scale(0) rotate(-15deg);
  }
  60% {
    transform: scale(1.2) rotate(5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

/* Notifications */
.notification-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 2000;
  display: grid;
  gap: 10px;
  max-width: 360px;
}

.notification-toast {
  padding: 14px 18px;
  border-radius: 16px;
  background: var(--paper-strong);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 12px;
  animation: toastIn 300ms ease;
}

.notification-toast.info {
  border-left: 4px solid var(--accent);
}

.notification-toast.success {
  border-left: 4px solid #22c55e;
}

.notification-toast.warning {
  border-left: 4px solid #f59e0b;
}

@keyframes toastIn {
  0% {
    opacity: 0;
    transform: translateX(40px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes toastOut {
  0% {
    opacity: 1;
    transform: translateX(0);
  }
  100% {
    opacity: 0;
    transform: translateX(40px);
  }
}

/* Away Brief */
.away-brief-list {
  display: grid;
  gap: 10px;
  padding: 0;
  list-style: none;
}

.away-brief-list li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
}

.intro-panel {
  display: grid;
  gap: 18px;
}

.intro-card {
  padding: 16px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--line);
}

.intro-card h4 {
  margin: 0 0 8px;
  font-size: 1rem;
}

.intro-card p,
.intro-card ul {
  margin: 0;
  color: var(--muted);
}

.intro-card ul {
  padding-left: 18px;
  display: grid;
  gap: 6px;
}

.consensus-panel {
  display: grid;
  gap: 18px;
}

.deviator-card {
  padding: 16px;
  border-radius: 16px;
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.25);
}

.deviator-card h4 {
  margin: 0 0 6px;
  color: #b91c1c;
}

.deviator-card p {
  margin: 0;
  color: var(--muted);
}

.consensus-ok-card {
  padding: 16px;
  border-radius: 16px;
  background: rgba(34, 197, 94, 0.08);
  border: 1px solid rgba(34, 197, 94, 0.25);
}

.consensus-ok-card h4 {
  margin: 0 0 6px;
  color: #15803d;
}

.consensus-ok-card p {
  margin: 0;
  color: var(--muted);
}

@media (max-width: 960px) {
  .layout,
  .result-grid,
  .three-columns {
    grid-template-columns: 1fr;
  }

  .topbar,
  .winner-band,
  .rating-row,
  .criterion-row {
    flex-direction: column;
    align-items: stretch;
  }

  .score-picker {
    min-width: 0;
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .ranking-row {
    grid-template-columns: 1fr;
  }

  .modal-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .checkbox-label {
    margin-right: 0;
  }
}

.welcome-banner {
  padding: 18px 22px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.12), rgba(217, 119, 6, 0.08));
  border: 1px solid var(--line);
}

.welcome-text {
  margin: 0;
  color: var(--text);
  font-size: 1.05rem;
  line-height: 1.5;
}

.status-card .status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 12px;
}

.status-card .status-grid div {
  display: grid;
  gap: 4px;
  text-align: center;
  padding: 12px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid var(--line);
}

.status-card .status-grid span {
  font-size: 0.85rem;
  color: var(--muted);
}

.status-card .status-grid strong {
  font-size: 1.3rem;
  color: var(--text);
}

